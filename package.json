{
  "name": "synagent-mcp",
  "displayName": "SynAgent MCP - Cross-Agent CLI Bridge",
  "version": "0.9.0-dev",
  "description": "Bridge Codex CLI, Claude Code CLI, and Gemini CLI through MCP in VS Code, Cursor, and Antigravity.",
  "main": "dist/index.cjs",
  "bin": {
    "synagent": "./dist/index.cjs",
    "synagent-mcp": "./dist/index.cjs",
    "omniagent": "./dist/index.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nyupyu/synagent.git"
  },
  "author": {
    "name": "Oktawian Wybieralski",
    "url": "https://oki.dev"
  },
  "homepage": "https://oki.dev",
  "license": "MIT",
  "type": "commonjs",
  "files": [
    "dist/",
    "index.js",
    "src/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "url": "https://github.com/nyupyu/synagent/issues"
  },
  "scripts": {
    "build": "node -r ./scripts/node20-polyfill.cjs ./node_modules/tsdown/dist/run.mjs src/index.ts --format cjs --target node20 --clean --sourcemap --no-config",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.cjs",
    "test": "tsx --test"
  },
  "keywords": [
    "cli",
    "codex",
    "claude",
    "claude-code",
    "gemini",
    "gemini-cli",
    "mcp",
    "agent",
    "bridge",
    "code-review",
    "multi-agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
